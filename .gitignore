.DS_Store
Thumbs.db
*.bak
*.swp
*.tmp
.vscode/
.idea/

# Worktrees et état local des agents Claude Code (copies complètes du dépôt).
# Exception : le hook de démarrage de session et sa déclaration, qui doivent
# être versionnés pour s'appliquer aux futures sessions Claude Code sur le web.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/session-start.sh

# Correctifs exportes pendant le developpement (git format-patch, git diff >).
# Ce sont des artefacts de travail : le contenu vit dans l'historique, pas a la
# racine du depot public.
*.patch
*.diff

# Python (outillage scripts/ et tests/)
__pycache__/
*.pyc
.venv/
.env
.env.*
!.env.example
!**/.env.example

# Profil actif choisi par l'utilisateur (local — voir skill/profils/)
profil.md
skill/profil.md

# Sorties de travail du benchmark agentique. Les baselines retenues sont
# commitées explicitement sous tests/bench/baselines/.
tests/bench/runs/
